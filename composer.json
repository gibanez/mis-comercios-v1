{
    "name": "gaby/mis-comercios",
    "description": "mis-comercios v1 — backend PHP 8.2 + Slim 4 + DDD liviano + MySQL 8",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "lcobucci/jwt": "^5.0",
        "nyholm/psr7": "^1.5",
        "nyholm/psr7-server": "^1.0",
        "php-di/php-di": "^6.4",
        "ramsey/uuid": "^4.2",
        "robmorgan/phinx": "^0.14",
        "slim/slim": "^4"
    },
    "require-dev": {
        "pestphp/pest": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Gaby\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gaby\\Tests\\": "src/tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0",
            "ext-sodium": "1.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest"
    }
}
